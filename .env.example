# =====================================================================
# NOC & OPS MANAGEMENT PORTAL - ENVIRONMENT CONFIGURATION TEMPLATE
# =====================================================================
# Copy this file to .env:
#   cp .env.example .env
#
# NOTE: The portal does NOT require SharePoint. It uses local AI (Ollama)
# to autonomously read Outlook emails regarding Nubitel issues and
# parse WhatsApp workgroups into tickets and executive summaries.
# =====================================================================

# ---------------------------------------------------------------------
# CLIENT-SIDE ENVIRONMENT VARIABLES (Vite prefixes with VITE_)
# ---------------------------------------------------------------------
# Base application URL (no trailing slash)
VITE_APP_URL=https://tmissuetracker.netlify.app

# Local AI Engine (Ollama):
# Local Ollama endpoint URL (default is http://localhost:11434)
VITE_OLLAMA_ENDPOINT=http://localhost:11434

# Local LLM model tag installed in Ollama (e.g. llama3, mistral, qwen2.5:7b, phi3)
VITE_OLLAMA_MODEL=llama3

# Local Outlook Inbox subfolder monitored for Nubitel escalations
VITE_OUTLOOK_SCAN_FOLDER=Inbox/Nubitel Issues

# Local WhatsApp workgroup export path
VITE_WHATSAPP_FOLDER=C:\Users\fayiz.m\NOC Tracker v4\WhatsApp

# Standalone / Sample Data Mode:
# Set to 'true' for standalone/demo presentations with verified historical datasets.
# Set to 'false' to connect exclusively to your active local Ollama daemon.
VITE_USE_SAMPLE_DATA=true

# Background Automatic Scan Interval (in minutes)
VITE_AUTO_SCAN_INTERVAL=15

# API Base URL for Netlify Functions (defaults to /.netlify/functions/ollama-sync)
VITE_API_BASE_URL=/.netlify/functions/ollama-sync

# ---------------------------------------------------------------------
# SERVER-SIDE / NETLIFY SERVERLESS FUNCTIONS (OPTIONAL)
# ---------------------------------------------------------------------
# Default NOC notification sender
EMAIL_FROM_ADDRESS=tmnoc@scicom.com.my

# Optional SendGrid/Mailgun API key for automated invitations
EMAIL_PROVIDER_API_KEY=your_optional_email_api_key_here
